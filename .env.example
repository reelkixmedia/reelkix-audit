# Copy to .env and fill in. Blank values fall back to offline/dev behaviour (see creator_audit/config.py).

BASE_URL=http://localhost:8000
PRODUCT_NAME=Creator Audit
BRAND=Reelkix
BUSINESS_ADDRESS=Reelkix, 123 Example St, Tampa, FL 33602, USA
SUPPORT_EMAIL=support@reelkix.com
ADMIN_EMAIL=
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Stripe (blank = dev checkout that marks orders paid instantly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_STANDARD_CENTS=1999
PRICE_PREMIUM_CENTS=4900
PRICE_UNLOCK_CENTS=499
UNLOCK_ENABLED=true

# Claude (blank = deterministic template writer)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# YouTube Data API key ("fake" = synthetic offline data)
YOUTUBE_API_KEY=fake

# Email (blank SMTP_HOST = write .eml files to data/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Reelkix Audits <audits@reelkix.com>
OUTREACH_FROM=Reelkix <hello@reelkix.com>

# Outreach scanner
OUTREACH_NICHES=fitness,cooking,gaming
OUTREACH_MIN_SUBS=1000
OUTREACH_MAX_SUBS=100000
OUTREACH_ACTIVE_DAYS=30
OUTREACH_DECLINE_RATIO=0.8
OUTREACH_SEARCHES_PER_DAY=60
OUTREACH_AUTO_APPROVE_IMPORTS=false
OUTREACH_DAILY_SEND_LIMIT=40
OUTREACH_FOLLOWUP_DAYS=4
OUTREACH_MAX_FOLLOWUPS=1
OUTREACH_SEND_START_HOUR=9
OUTREACH_SEND_END_HOUR=17
TEASER_EXPIRY_DAYS=30
API_DATA_RETENTION_DAYS=30
SCANNER_HOUR=6

# Mascot render worker shared secret (Phase 2)
VIDEO_WORKER_KEY=

# Local business scanner (GOOGLE_PLACES_API_KEY=fake = synthetic offline businesses)
GOOGLE_PLACES_API_KEY=fake
LOCAL_CATEGORIES=nail salon,barber shop,auto repair,restaurant
LOCAL_CITIES=Tampa FL
LOCAL_SEARCHES_PER_DAY=33
LOCAL_TARGET=no_website
LOCAL_GATE=paywall
CONSULT_URL=
PRICE_WEBSITE_CENTS=20000
MOCK_EXPIRY_DAYS=30
LOCAL_AI_CHECK=false
SITE_DOMAIN_HINT=sites.reelkix.com

# Postcards via Lob (blank key = postcards written to data/postcards; budget 0 = postcards off)
LOB_API_KEY=
POSTCARD_COST_CENTS=90
POSTCARD_MONTHLY_BUDGET_CENTS=0
RETURN_NAME=Reelkix
RETURN_LINE1=123 Example St
RETURN_CITY=Tampa
RETURN_STATE=FL
RETURN_ZIP=33602
